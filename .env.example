# ─── Formulaire de contact ────────────────────────────────────────────
# Tant que ces variables sont absentes, le formulaire affiche un message
# invitant à appeler directement (aucune demande n'est perdue en silence :
# elle est aussi écrite dans les logs du serveur).
#
# 1. Créer un compte gratuit sur https://resend.com
# 2. Vérifier le domaine du site (ou utiliser onboarding@resend.dev pour tester)
# 3. Copier ce fichier en `.env.local` et remplir les valeurs

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice — doit appartenir à un domaine vérifié chez Resend.
# Une adresse Gmail ne fonctionne PAS ici (Resend refuse d'usurper gmail.com).
# Pour tester sans domaine : onboarding@resend.dev
CONTACT_FROM="Site KDS <site@kevinducrouxservices.fr>"

# Adresse qui reçoit les demandes de devis — là, Gmail convient très bien.
CONTACT_TO=kevinducrouxservices@gmail.com
